{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "zk-smart-account-kit-sdk": ["./src/index.ts"],
      "zk-smart-account-kit-sdk/*": ["./src/*/index.ts"],
      "zk-smart-account-kit-sdk/zk-multisig/safe": ["./src/zk-multisig/safe.ts"],
      "zk-smart-account-kit-sdk/zk-multisig/nexus": ["./src/zk-multisig/nexus.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "examples/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist", "docs/api"]
}
